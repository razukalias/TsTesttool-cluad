<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LoadTestingTool.UI.DataEditor"
        x:Class="LoadTestingTool.UI.DataEditor.DataEditorWindow"
        x:DataType="vm:EditorShellViewModel"
        Title="Data editor"
        Width="1360" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0A1421">

  <Window.Styles>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#132338" />
      <Setter Property="Foreground" Value="#E3EDF9" />
      <Setter Property="SeparatorBrush" Value="#22364D" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#16335A" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="WrapPanel.form > :is(Control)">
      <Setter Property="Margin" Value="0,0,10,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="#16335A" />
      <Setter Property="BorderBrush" Value="#3291FF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#0F1C2E" />
      <Setter Property="BorderBrush" Value="#22364D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#8EA4BC" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="300,*">

    <!-- Instances as parents, their testcases as children -->
    <Border Grid.Column="0" Background="#0C1828" BorderBrush="#22364D" BorderThickness="0,0,1,0" Padding="12,16">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,0,0,10">
          <TextBlock Classes="caption" Text="INSTANCES" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Refresh results" Command="{Binding RefreshResultsCommand}" IsEnabled="{Binding !IsLoadingResults}" MinHeight="28" Padding="10,2" FontSize="12" />
        </Grid>
        <CheckBox DockPanel.Dock="Bottom" Content="Load instances only when opened" IsChecked="{Binding LazyLoading, Mode=TwoWay}" Margin="6,12,0,0" FontSize="12"
                  ToolTip.Tip="On: a workbook is read the first time you click its instance, so the editor opens quickly with many or large workbooks. Off: every workbook is read when the editor opens." />
        <TreeView ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent">
          <TreeView.DataTemplates>
            <TreeDataTemplate DataType="vm:InstanceNode" ItemsSource="{Binding Testcases}">
              <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding DirtyColor}" IsVisible="{Binding IsDirty}" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8EA4BC" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding RunSummary}" FontSize="11" Foreground="#6F87A1" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
            <DataTemplate DataType="vm:TestcaseItem">
              <StackPanel Spacing="1" Margin="0,3">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#8EA4BC" />
                <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResults}" Foreground="{Binding ResultColor}" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
            </DataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </DockPanel>
    </Border>

  <Grid Grid.Column="1" DataContext="{Binding Current}" x:DataType="vm:DataEditorViewModel" RowDefinitions="Auto,Auto,*,Auto">

    <!-- Title bar: what is open, whether it is saved, and the main actions -->
    <Border Grid.Row="0" Background="#0F1C2E" BorderBrush="#22364D" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding InstanceName}" FontSize="12" Foreground="#8EA4BC" />
          <TextBlock Text="{Binding SelectedTestcase.Title, FallbackValue=Data editor}" FontSize="20" FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{Binding SaveStatusColor}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SaveStatusText}" Foreground="{Binding SaveStatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Content="Add row" Command="{Binding AddRowCommand}" IsVisible="{Binding ShowData}" MinHeight="36" />
          <Button Content="Duplicate" Command="{Binding DuplicateRowCommand}" IsVisible="{Binding ShowData}" IsEnabled="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}" MinHeight="36" />
          <Button Content="Remove" Classes="danger" Command="{Binding RemoveRowCommand}" IsVisible="{Binding ShowData}" IsEnabled="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}" MinHeight="36" />
          <Button Content="Run row" Command="{Binding RunRowCommand}" IsVisible="{Binding ShowData}" IsEnabled="{Binding CanRun}" ToolTip.Tip="Run only the selected data row (save first)" MinHeight="36" />
          <Button Content="▶ Run…" Classes="primary" IsEnabled="{Binding CanRun}" ToolTip.Tip="Run this testcase, several testcases or the whole instance (save first)" MinHeight="36">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="340" Spacing="10" x:DataType="vm:DataEditorViewModel">
                  <TextBlock Classes="caption" Text="RUN" />
                  <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.ScopeOptions}" SelectedItem="{Binding RunScope, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                  <ItemsControl ItemsSource="{Binding Testcases}" IsVisible="{Binding ChoosingTestcases}" MaxHeight="180">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TestcaseItem">
                        <CheckBox IsChecked="{Binding IsChosen, Mode=TwoWay}" Content="{Binding Title}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Testcases" FontSize="12" Foreground="#8EA4BC" IsVisible="{Binding CanChooseOrder}" />
                  <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.TestcaseOrderOptions}" SelectedItem="{Binding TestcaseOrder, Mode=TwoWay}" IsVisible="{Binding CanChooseOrder}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="Rows" FontSize="12" Foreground="#8EA4BC" />
                  <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.RowsModeOptions}" SelectedItem="{Binding RowsMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="{Binding RunSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#C9D8EA" />
                  <Button Content="▶ Run" Classes="primary" Command="{Binding RunCommand}" HorizontalAlignment="Right" MinWidth="90" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ToggleButton Content="Preview request" IsChecked="{Binding PreviewVisible, Mode=TwoWay}" ToolTip.Tip="Show what a step sends for the selected row" MinHeight="36" />
          <Border Width="1" Background="#22364D" Margin="4,6" />
          <Button Content="Add step" Command="{Binding AddStepCommand}" IsVisible="{Binding ShowSteps}" MinHeight="36" />
          <Button Content="Remove step" Classes="danger" Command="{Binding RemoveStepCommand}" IsVisible="{Binding ShowSteps}" IsEnabled="{Binding SelectedStep, Converter={x:Static ObjectConverters.IsNotNull}}" MinHeight="36" />
          <Border Width="1" Background="#22364D" Margin="4,6" />
          <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}" MinHeight="36" />
          <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}" MinHeight="36" />
          <Border Width="1" Background="#22364D" Margin="4,6" />
          <Button Content="Reload" Command="{Binding ReloadCommand}" MinHeight="36" />
          <Button Content="Save" Classes="primary" Click="OnSaveClick" MinHeight="36" MinWidth="76" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Banners: file changed on disk, and unsaved changes on close -->
    <StackPanel Grid.Row="1">
      <Border IsVisible="{Binding ConflictVisible}" Background="#3A2E14" BorderBrush="#8A6A1F" BorderThickness="0,0,0,1" Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="The workbook changed on disk" FontWeight="Bold" Foreground="#F6C76B" />
            <TextBlock Text="It was saved by someone else, or by Excel, after you opened it. Reload to take that version and lose your edits, or overwrite it with yours."
                       TextWrapping="Wrap" Foreground="#F3D9A4" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="Reload, lose my edits" Command="{Binding ReloadCommand}" />
            <Button Content="Overwrite with my edits" Classes="danger" Command="{Binding OverwriteAndSaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border IsVisible="{Binding ClosePromptVisible}" Background="#12315A" BorderBrush="#2F6FD0" BorderThickness="0,0,0,1" Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="You have unsaved changes" FontWeight="Bold" Foreground="#9CCBFF" />
            <TextBlock Text="Save them to the workbook before closing, or discard them." Foreground="#C6DEFA" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="Keep editing" Command="{Binding KeepEditingCommand}" />
            <Button Content="Discard and close" Classes="danger" Command="{Binding DiscardAndCloseCommand}" />
            <Button Content="Save and close" Classes="primary" Command="{Binding SaveAndCloseCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Testcases | data grid | problems -->
    <Grid Grid.Row="2" ColumnDefinitions="*,330" Margin="16,16,16,8">

      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,12,0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Data" Classes="tab" Classes.active="{Binding ShowData}" Command="{Binding OpenDataTabCommand}" />
            <Button Content="Steps" Classes="tab" Classes.active="{Binding ShowSteps}" Command="{Binding OpenStepsTabCommand}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding RowCountText}" IsVisible="{Binding ShowData}" Foreground="#8EA4BC" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="1" IsVisible="{Binding ShowData}" Spacing="10" Margin="0,0,0,10">
        <Grid ColumnDefinitions="220,Auto,*,Auto,Auto,Auto,Auto">
          <TextBox Grid.Column="0" Text="{Binding FilterText, Mode=TwoWay}" Watermark="Filter rows" MinHeight="36" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="14,0,0,0" VerticalAlignment="Center">
            <CheckBox Content="Show every column" IsChecked="{Binding ShowAllColumns, Mode=TwoWay}" />
            <CheckBox Content="Failed rows only" IsChecked="{Binding ShowFailedOnly, Mode=TwoWay}" IsEnabled="{Binding HasResults}" />
          </StackPanel>
          <Button Grid.Column="3" Content="Find &amp; replace" Command="{Binding OpenFindCommand}" Margin="14,0,0,0" MinHeight="36" />
          <Button Grid.Column="4" Content="Add column" Command="{Binding OpenAddColumnCommand}" Margin="14,0,0,0" MinHeight="36" />
          <Button Grid.Column="5" Content="Import CSV…" Command="{Binding ImportCsvFileCommand}" Margin="8,0,0,0" MinHeight="36" />
          <Button Grid.Column="6" Content="Export CSV…" Command="{Binding ExportCsvFileCommand}" Margin="8,0,0,0" MinHeight="36" />
        </Grid>
        <Border IsVisible="{Binding FindVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="FIND &amp; REPLACE (in the rows shown)" />
            <WrapPanel Classes="form">
              <TextBox x:Name="FindBox" Text="{Binding FindText, Mode=TwoWay}" Watermark="Find" MinWidth="200" />
              <TextBox Text="{Binding ReplaceText, Mode=TwoWay}" Watermark="Replace with" MinWidth="200" />
              <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.FindScopes}" SelectedItem="{Binding FindScope, Mode=TwoWay}" MinWidth="150" />
              <CheckBox Content="Match case" IsChecked="{Binding FindMatchCase, Mode=TwoWay}" />
              <CheckBox Content="Whole cell" IsChecked="{Binding FindWholeCell, Mode=TwoWay}" />
              <Button Content="Replace all" Classes="primary" Command="{Binding ReplaceAllCommand}" />
              <Button Content="Close" Command="{Binding CloseFindCommand}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding MatchSummary}" Foreground="#8EA4BC" />
              <TextBlock Foreground="#8EA4BC" IsVisible="{Binding FindScopeIsCurrent}">
                <Run Text="Current column:" /><Run Text="{Binding CurrentColumnTitle, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding AddColumnVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="NEW DATA COLUMN" />
            <WrapPanel Classes="form">
              <ComboBox ItemsSource="{Binding NewColumnSteps}" SelectedItem="{Binding NewColumnStep, Mode=TwoWay}" PlaceholderText="Step" MinWidth="160" />
              <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.ColumnKinds}" SelectedItem="{Binding NewColumnKind, Mode=TwoWay}" MinWidth="150" />
              <ComboBox IsVisible="{Binding NewColumnIsExpected}" ItemsSource="{x:Static vm:DataEditorViewModel.AssertionVerbs}" SelectedItem="{Binding NewColumnVerb, Mode=TwoWay}" MinWidth="130" />
              <TextBox Text="{Binding NewColumnName, Mode=TwoWay}" Watermark="{Binding NewColumnHint}" MinWidth="260" />
              <Button Content="Add column" Classes="primary" Command="{Binding ConfirmAddColumnCommand}" />
              <Button Content="Cancel" Command="{Binding CancelAddColumnCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
        <Border Grid.Row="2" IsVisible="{Binding ShowData}" Classes="panel" ClipToBounds="True">
          <DataGrid x:Name="Grid"
                    ItemsSource="{Binding VisibleRows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    SelectionMode="Extended"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    FrozenColumnCount="2"
                    RowHeight="36"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalGridLinesBrush="#1B2D44"
                    VerticalGridLinesBrush="#1B2D44" />
        </Border>
        <Border Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding ShowSteps}" Classes="panel" ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="#22364D" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Steps run top to bottom, in sheet order. Names of existing steps are fixed because data columns refer to them." Foreground="#8EA4BC" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding StepCountText}" Foreground="#8EA4BC" Margin="16,0,0,0" />
              </Grid>
            </Border>
            <DataGrid x:Name="StepsGrid"
                      ItemsSource="{Binding StepRows}"
                      SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      FrozenColumnCount="1"
                      RowHeight="36"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalGridLinesBrush="#1B2D44"
                      VerticalGridLinesBrush="#1B2D44" />
          </DockPanel>
        </Border>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <Border Classes="panel" Padding="14" IsVisible="{Binding PreviewVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <TextBlock Classes="caption" Text="PREVIEW · SELECTED ROW" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding PreviewStepNames}" SelectedItem="{Binding PreviewStepName, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="Edit template…" Command="{Binding EditTemplateCommand}" Margin="8,0,0,0" ToolTip.Tip="Open this step's template file in the template editor" />
            </Grid>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.Warning}" IsVisible="{Binding Preview.HasWarning, FallbackValue=False}" Foreground="#F6C76B" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
          <ScrollViewer>
            <StackPanel Spacing="6" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Preview.Title}" FontWeight="SemiBold" />
              <TextBox Text="{Binding Preview.Url, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
              <TextBlock Classes="caption" Text="HEADERS" IsVisible="{Binding Preview.HeadersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
              <TextBox Text="{Binding Preview.HeadersText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="12" IsVisible="{Binding Preview.HeadersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
              <TextBlock Classes="caption" Text="BODY" />
              <TextBox Text="{Binding Preview.Body, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="140" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Classes="panel" Padding="14" IsVisible="{Binding !PreviewVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
            <TextBlock Classes="caption" Text="PROBLEMS" />
            <TextBlock Text="{Binding ProblemSummary}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasNoProblems}" Foreground="#39D39B"
                     Text="The runner will accept this workbook." TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProblemViewModel">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="10" Padding="8,1" Background="{Binding BadgeBackground}">
                      <TextBlock Text="{Binding SeverityText}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Location}" Foreground="#8EA4BC" FontSize="11.5" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Classes="panel" Padding="14" Margin="0,12,0,0" MaxHeight="360" IsVisible="{Binding HasRowResult}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="caption" Text="LAST RUN · SELECTED ROW" />
            <TextBlock Text="{Binding RowResultHeadline}" Foreground="{Binding RowResultColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox ItemsSource="{Binding RowFailures}" SelectedItem="{Binding SelectedFailure, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FailureViewModel">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="10" Padding="8,1" Background="#432333">
                      <TextBlock Text="{Binding Kind}" Foreground="#FF7588" FontSize="10.5" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="#C9D8EA" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      </Grid>
    </Grid>

    <!-- Status line -->
    <Border Grid.Row="3" Background="#0F1C2E" BorderBrush="#22364D" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#8EA4BC" TextTrimming="CharacterEllipsis">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Foreground" Value="#8EA4BC" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#8EA4BC" FontSize="12" Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
  </Grid>
</Window>
