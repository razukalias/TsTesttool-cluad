<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LoadTestingTool.UI.DataEditor"
        x:Class="LoadTestingTool.UI.DataEditor.DataEditorWindow"
        x:DataType="vm:EditorShellViewModel"
        Title="Data editor"
        Width="1360" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0A1421">

  <Window.Resources>
    <!-- Tighter tree: a child is indented 10 px per level instead of 16 -->
    <x:Double x:Key="TreeViewItemIndent">10</x:Double>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.stepcard"><Setter Property="Background" Value="#13233A" /><Setter Property="BorderBrush" Value="#22364F" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button.stepheader"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="14,10" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="#132338" />
      <Setter Property="Foreground" Value="#E3EDF9" />
      <Setter Property="SeparatorBrush" Value="#22364D" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="#13233A" />
      <Setter Property="BorderBrush" Value="#26405C" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1B3454" />
    </Style>
    <Style Selector="Button.tool.danger">
      <Setter Property="Background" Value="#2A1B2B" />
      <Setter Property="BorderBrush" Value="#7C3A4A" />
    </Style>
    <Style Selector="DataGridColumnHeader.colsel">
      <Setter Property="Background" Value="#1D4F8F" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="#16335A" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="WrapPanel.form > :is(Control)">
      <Setter Property="Margin" Value="0,0,10,8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="#16335A" />
      <Setter Property="BorderBrush" Value="#3291FF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
      <Setter Property="Padding" Value="0,1" />
    </Style>
    <!-- Expand / collapse as a small box with ＋ and − instead of the arrow, narrow so the tick box and name sit close to it -->
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Width" Value="35" />
      <Setter Property="Height" Value="16" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Viewbox Width="16" Height="16" Margin="0,0,3,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24"><Path Data="{ReflectionBinding IconData}" Stroke="#8EA4BC" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas>
            </Viewbox>
            <Border Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="#3A5373" Background="#13233A">
              <TextBlock Name="glyph" Text="＋" FontSize="11" FontWeight="Bold" Foreground="#9DB4CF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ TextBlock#glyph">
      <Setter Property="Text" Value="−" />
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:pointerover /template/ Border#box">
      <Setter Property="BorderBrush" Value="#5AA9FF" />
    </Style>
    <Style Selector="Button.treemove">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8EA4BC" />
    </Style>
    <Style Selector="Button.treeenv">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="CheckBox.treeparallel">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.treerun">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#39D39B" />
    </Style>
    <Style Selector="Button.treerun:disabled">
      <Setter Property="Foreground" Value="#3F536A" />
    </Style>
    <Style Selector="Button.status">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.status:pointerover">
      <Setter Property="Background" Value="#1B2D45" />
    </Style>
    <Style Selector="Button.treerun:pointerover">
      <Setter Property="Foreground" Value="#7BF0C4" />
    </Style>
    <Style Selector="CheckBox.treecheck">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.treemove:pointerover">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#0F1C2E" />
      <Setter Property="BorderBrush" Value="#22364D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#8EA4BC" />
    </Style>
  </Window.Styles>

  <Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="360" MinWidth="180" MaxWidth="700" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" MinWidth="500" />
  </Grid.ColumnDefinitions>

    <!-- Instances as parents, their testcases as children -->
    <Border Grid.Column="0" Background="#0C1828" BorderBrush="#22364D" BorderThickness="0,0,1,0" Padding="6,12,4,12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="2,0,0,8">
          <TextBlock Classes="caption" Text="INSTANCES" VerticalAlignment="Center" Margin="0,0,8,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="NewInstanceButton" Content="＋" Classes="treemove" FontSize="13" ToolTip.Tip="New instance: a blank workbook with its folders" />
            <Button x:Name="DuplicateInstanceButton" Content="⧉" Classes="treemove" FontSize="13" ToolTip.Tip="Duplicate the selected instance (workbook, templates and files; no results or logs)" />
          </StackPanel>
          <Button Grid.Column="3" Content="Refresh results" Command="{Binding RefreshResultsCommand}" IsEnabled="{Binding !IsLoadingResults}" MinHeight="28" Padding="10,2" FontSize="12" />
        </Grid>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="6,0,0,10">
          <Button x:Name="RunTickedButton" IsEnabled="{Binding CanRunTicked}" MinHeight="28" Padding="10,2" FontSize="12" ToolTip.Tip="Run what is ticked (save first). If data rows are ticked in the grid, only those rows run; otherwise the ticked testcases and steps in the tree. Each instance is started with its own selection.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="▶ Run ticked" />
              <TextBlock Text="{Binding TickedBadge}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button x:Name="ExpandAllButton" Content="⊞" Classes="treemove" FontSize="14" ToolTip.Tip="Expand all instances, testcases and steps" />
          <Button x:Name="CollapseAllButton" Content="⊟" Classes="treemove" FontSize="14" ToolTip.Tip="Collapse everything to the instance rows" />
          <TextBlock Text="{Binding TickedText}" VerticalAlignment="Center" FontSize="11" Foreground="#8EA4BC" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,0,0,8">
          <TextBox x:Name="InstanceFilterBox" Text="{Binding InstanceFilter, Mode=TwoWay}" Watermark="Filter instances: term1 &amp; term2…" MinHeight="28" FontSize="12"
                   ToolTip.Tip="Show only the instances whose name contains every word (separate words with &amp;). Esc clears it." />
          <Button x:Name="RunShownButton" Grid.Column="1" Margin="6,0,0,0" IsEnabled="{Binding CanRunShown}" MinHeight="28" Padding="10,2" FontSize="12"
                  ToolTip.Tip="Run every instance shown in the tree completely (all testcases and rows), whatever is ticked. Save first.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▶ Run shown" />
              <TextBlock Text="{Binding RunShownBadge}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding InstanceFilterText}" Margin="8,-4,0,6" FontSize="11" Foreground="#8EA4BC" IsVisible="{Binding InstanceFilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- Run settings: one small button opens Environments / Rows; the chosen values are written beneath -->
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8" Spacing="1" IsVisible="{Binding HasRunSettings}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caption" Text="ALL INSTANCES" VerticalAlignment="Center" />
            <Button x:Name="GlobalRunSettingsButton" Grid.Column="1" Content="✎" Classes="treemove" FontSize="13" ToolTip.Tip="Edit environments and row execution for every instance (saved to appsettings.json)">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <TabControl Width="330">
                    <TabItem Header="Environments" IsVisible="{Binding CanManageEnvironments}">
                      <StackPanel Spacing="6" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding GlobalEnvironmentChoices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:EnvironmentChoice">
                              <Grid ColumnDefinitions="*,Auto">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChosen, Mode=TwoWay}" Margin="2" />
                                <Button Grid.Column="1" Content="✕" Classes="treemove" Tag="{Binding Name}" Click="OnRemoveEnvironmentClick" ToolTip.Tip="Remove this environment from the list and from every instance" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox x:Name="NewEnvironmentBox" Watermark="New environment, e.g. qa" />
                          <Button Grid.Column="1" Content="＋ Add" Classes="primary" Margin="6,0,0,0" Click="OnAddEnvironmentClick" />
                        </Grid>
                        <TextBlock Text="{Binding EnvironmentEditMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="#8EA4BC" IsVisible="{Binding HasEnvironmentEditMessage}" />
                        <Border Height="1" Background="#22364D" Margin="0,2" IsVisible="{Binding HasEnvironments}" />
                        <CheckBox Content="Run environments in parallel" IsVisible="{Binding HasEnvironments}" IsChecked="{Binding GlobalRunParallel, Mode=TwoWay}" ToolTip.Tip="Run environments (and testcases) at the same time, for every instance. This is the central setting the runner uses." />
                      </StackPanel>
                    </TabItem>
                    <TabItem Header="Rows" IsVisible="{Binding HasExecution}">
                      <vm:ExecutionPanel DataContext="{Binding Execution}" Margin="0,8,0,0" />
                    </TabItem>
                  </TabControl>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding CanManageEnvironments}">
            <TextBlock Text="Env" FontSize="11" Foreground="#6F87A1" />
            <TextBlock Text="{Binding GlobalEnvironmentsText}" FontSize="11" Foreground="#C9D8EA" />
            <TextBlock Text="· parallel" FontSize="11" Foreground="#8EA4BC" IsVisible="{Binding GlobalRunParallel}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasExecution}">
            <TextBlock Text="Rows" FontSize="11" Foreground="#6F87A1" />
            <TextBlock Text="{Binding Execution.Summary}" FontSize="11" Foreground="#C9D8EA" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <Button x:Name="HistoryLogsButton" DockPanel.Dock="Bottom" Content="History &amp; logs…" HorizontalAlignment="Left" Margin="0,8,0,0" MinHeight="28" Padding="10,2" FontSize="12"
                ToolTip.Tip="Choose what runs write to history and the internal log, with profiles for functional tests, debugging and load tests." />
        <Button x:Name="StorageCleanupButton" DockPanel.Dock="Bottom" Content="Storage &amp; cleanup…" HorizontalAlignment="Left" Margin="0,12,0,0" MinHeight="28" Padding="10,2" FontSize="12"
                ToolTip.Tip="Preview and permanently delete old workbook backups, logs, history and results." />
        <CheckBox DockPanel.Dock="Bottom" Content="Load instances only when opened" IsChecked="{Binding LazyLoading, Mode=TwoWay}" Margin="6,12,0,0" FontSize="12"
                  ToolTip.Tip="On: a workbook is read the first time you click its instance, so the editor opens quickly with many or large workbooks. Off: every workbook is read when the editor opens." />
        <TreeView x:Name="Tree" Padding="0,0,14,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleInstances}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent">
          <TreeView.DataTemplates>
            <TreeDataTemplate DataType="vm:InstanceNode" ItemsSource="{Binding Testcases}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3,0,3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                  <Viewbox Width="16" Height="16" Margin="0,1,6,0" VerticalAlignment="Top" IsVisible="{Binding $parent[TreeViewItem].ItemCount, Converter={x:Static vm:TreeConverters.IsZero}}"><Canvas Width="24" Height="24"><Path Data="{Binding IconData}" Stroke="#8EA4BC" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                  <Ellipse Width="8" Height="8" Margin="0,4,6,0" Fill="{Binding DirtyColor}" IsVisible="{Binding IsDirty}" />
                </StackPanel>
                <CheckBox Grid.Column="3" Classes="treecheck" Margin="6,0,0,0" IsChecked="{Binding ChosenState, Mode=TwoWay}" IsEnabled="{Binding IsLoaded}" ToolTip.Tip="Tick to run this instance's testcases together with the other ticked items" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <StackPanel Spacing="1" IsVisible="{Binding $parent[TreeViewItem].IsExpanded}">
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8EA4BC" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding RunSummary}" FontSize="11" Foreground="#6F87A1" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasEnvironments}">
                    <TextBlock Text="Env" FontSize="11" Foreground="#6F87A1" />
                    <TextBlock Text="{Binding EnvironmentsText}" FontSize="11" Foreground="#C9D8EA" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="· parallel" FontSize="11" Foreground="#8EA4BC" IsVisible="{Binding RunParallel}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasExecution}">
                    <TextBlock Text="Rows" FontSize="11" Foreground="#6F87A1" />
                    <TextBlock Text="{Binding Execution.Summary}" FontSize="11" Foreground="#C9D8EA" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                  <Button Classes="treemove" Content="✎" FontSize="12" IsVisible="{Binding HasRunSettings}" ToolTip.Tip="Edit this instance's environments and row execution (empty boxes use the global value)">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedRight">
                        <TabControl Width="330">
                          <TabItem Header="Environments" IsVisible="{Binding HasEnvironments}">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                              <ItemsControl ItemsSource="{Binding EnvironmentChoices}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:EnvironmentChoice">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChosen, Mode=TwoWay}" Margin="2" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Border Height="1" Background="#22364D" Margin="0,2" />
                              <CheckBox Content="Run environments in parallel" IsChecked="{Binding RunParallel, Mode=TwoWay}" ToolTip.Tip="Run this instance's environments (and testcases) at the same time." />
                            </StackPanel>
                          </TabItem>
                          <TabItem Header="Rows" IsVisible="{Binding HasExecution}">
                            <vm:ExecutionPanel DataContext="{Binding Execution}" Margin="0,8,0,0" />
                          </TabItem>
                        </TabControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button Classes="treemove" Tag="add" Content="＋" FontSize="12" ToolTip.Tip="Add a testcase to this instance" />
                  <Button Classes="treemove" Tag="toggle" Content="⇕" FontSize="12" ToolTip.Tip="Expand or collapse this instance and everything under it" />
                  <Button Classes="status" Tag="status" IsVisible="{Binding Run.HasStatus}" ToolTip.Tip="{Binding Run.Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Run.Icon}" Foreground="{Binding Run.Tint}" FontWeight="Bold" FontSize="13" />
                      <TextBlock Text="{Binding Run.Counts}" IsVisible="{Binding Run.HasCounts}" Foreground="{Binding Run.Tint}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="treerun" Tag="run" IsEnabled="{Binding Run.NotRunning}" IsVisible="{Binding Run.NotRunning}" ToolTip.Tip="Run the whole instance (only the ticked rows of this instance, if any are ticked)">
                    <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="▶" /><TextBlock Text="{Binding TickedRowsText}" IsVisible="{Binding HasTickedRows}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="treerun" Tag="stop" Content="⏹" Foreground="#FF6B6B" IsVisible="{Binding Run.IsRunning}" ToolTip.Tip="Stop this run (finishes the current requests, then stops)" />
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
            <DataTemplate DataType="vm:StepNode">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{Binding Indent}">
                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" IsVisible="{Binding $parent[TreeViewItem].ItemCount, Converter={x:Static vm:TreeConverters.IsZero}}"><Canvas Width="24" Height="24"><Path Data="{Binding IconData}" Stroke="#8EA4BC" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                <CheckBox Grid.Column="3" Classes="treecheck" Margin="6,0,0,0" IsChecked="{Binding IsChosen, Mode=TwoWay}" ToolTip.Tip="Tick to run this step on its own" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding IsNotEditing}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1" Classes="treeedit" Text="{Binding EditText, Mode=TwoWay}" IsVisible="{Binding IsEditing}" FontSize="12" MinHeight="24" Padding="4,2" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" IsVisible="{Binding IsNotEditing}">
                  <Button Classes="status" Tag="status" IsVisible="{Binding Run.HasStatus}" ToolTip.Tip="{Binding Run.Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Run.Icon}" Foreground="{Binding Run.Tint}" FontWeight="Bold" FontSize="13" />
                      <TextBlock Text="{Binding Run.Counts}" IsVisible="{Binding Run.HasCounts}" Foreground="{Binding Run.Tint}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="treerun" Tag="run" IsEnabled="{Binding Owner.InstanceRun.NotRunning}" ToolTip.Tip="Run this step (on the ticked rows of its testcase, if any are ticked)">
                    <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="▶" /><TextBlock Text="{Binding Owner.TickedRowsText}" IsVisible="{Binding Owner.HasTickedRows}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="treemove" Tag="up" Content="▲" ToolTip.Tip="Run earlier" />
                  <Button Classes="treemove" Tag="down" Content="▼" ToolTip.Tip="Run later" />
                </StackPanel>
              </Grid>
            </DataTemplate>
            <TreeDataTemplate DataType="vm:TestcaseItem" ItemsSource="{Binding StepNodes}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                <Viewbox Width="16" Height="16" Margin="0,1,7,0" VerticalAlignment="Top" IsVisible="{Binding $parent[TreeViewItem].ItemCount, Converter={x:Static vm:TreeConverters.IsZero}}"><Canvas Width="24" Height="24"><Path Data="{Binding IconData}" Stroke="#8EA4BC" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                <CheckBox Grid.Column="3" Classes="treecheck" Margin="6,0,0,0" VerticalAlignment="Top" IsChecked="{Binding ChosenState, Mode=TwoWay}" ToolTip.Tip="Tick to run this testcase together with the other ticked items" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Title}" IsVisible="{Binding IsNotEditing}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBox Classes="treeedit" Text="{Binding EditText, Mode=TwoWay}" IsVisible="{Binding IsEditing}" FontWeight="SemiBold" MinHeight="26" Padding="4,2" />
                  <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#8EA4BC" />
                  <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResults}" Foreground="{Binding ResultColor}" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top" IsVisible="{Binding IsNotEditing}">
                  <Button Classes="treemove" Tag="add" Content="＋" FontSize="12" ToolTip.Tip="Add a step to this testcase" />
                  <Button Classes="status" Tag="status" IsVisible="{Binding Run.HasStatus}" ToolTip.Tip="{Binding Run.Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Run.Icon}" Foreground="{Binding Run.Tint}" FontWeight="Bold" FontSize="13" />
                      <TextBlock Text="{Binding Run.Counts}" IsVisible="{Binding Run.HasCounts}" Foreground="{Binding Run.Tint}" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="treerun" Tag="run" IsEnabled="{Binding InstanceRun.NotRunning}" ToolTip.Tip="Run this testcase (only its ticked rows, if any are ticked)">
                    <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="▶" /><TextBlock Text="{Binding TickedRowsText}" IsVisible="{Binding HasTickedRows}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                  <Button Classes="treemove" Tag="up" Content="▲" ToolTip.Tip="Run earlier" />
                  <Button Classes="treemove" Tag="down" Content="▼" ToolTip.Tip="Run later" />
                </StackPanel>
              </Grid>
            </TreeDataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </DockPanel>
    </Border>

  <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast" ToolTip.Tip="Drag to resize" />

  <Grid Grid.Column="2" DataContext="{Binding Current}" x:DataType="vm:DataEditorViewModel" RowDefinitions="Auto,Auto,*,Auto">

    <!-- Title bar: what is open, whether it is saved, and the main actions -->
    <Border Grid.Row="0" Background="#0F1C2E" BorderBrush="#22364D" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding InstanceName}" FontSize="12" Foreground="#8EA4BC" />
          <TextBlock Text="{Binding SelectedTestcase.Title, FallbackValue=Data editor}" FontSize="20" FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Fill="{Binding SaveStatusColor}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SaveStatusText}" Foreground="{Binding SaveStatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
            <Button Content="↶  Undo" Classes="tool" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}" />
            <Button Content="↷  Redo" Classes="tool" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}" />
            <Border Width="1" Background="#22364D" Margin="4,4" />
            <Button Content="Reload" Classes="tool" Command="{Binding ReloadCommand}" ToolTip.Tip="Read the workbook from disk again" />
            <Button Content="Backups…" Classes="tool" Click="OnBackupsClick" ToolTip.Tip="Restore this workbook from an earlier backup (filter by date and time)" />
            <Button Content="Save" Classes="primary" Click="OnSaveClick" MinHeight="32" MinWidth="84" ToolTip.Tip="Write the changes to the workbook (Ctrl+S)" />
          </StackPanel>
          <!-- a fixed-height box, so the editor area below starts at the same place and has the same height in Table view, Config edit mode and Record view -->
          <ScrollViewer Tag="toolbar-area" Height="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
          <WrapPanel Orientation="Horizontal">
            <WrapPanel.Styles>
              <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="0,0,6,6" /></Style>
            </WrapPanel.Styles>
          </WrapPanel>
            <WrapPanel IsVisible="{Binding ShowData}">
              <CheckBox Content="Show all rows" IsChecked="{Binding ShowAllRows, Mode=TwoWay}" IsVisible="{Binding SheetHasRowToggle}" VerticalAlignment="Center" Margin="0,0,14,8" ToolTip.Tip="Config sheet: show every row, not only the selected testcase's or step's" />
              <TextBlock Text="{Binding SheetSummary}" IsVisible="{Binding ShowSheetGrid}" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="0,0,14,8" />
            </WrapPanel>
            <WrapPanel IsVisible="{Binding ShowDataGrid}">
              <TextBox Width="260" Text="{Binding HeaderFilter, Mode=TwoWay}" Watermark="Headers: header1 &amp; header2…" ToolTip.Tip="Keep columns whose header contains any term. Separate terms with &amp;" MinHeight="36" Margin="0,0,10,8" />
              <TextBox Width="130" Text="{Binding RowNumberFilter, Mode=TwoWay}" Watermark="Rows: 1,2,5-9…" ToolTip.Tip="Keep these rows only. 1 is the first row of the testcase" MinHeight="36" Margin="0,0,10,8" />
              <TextBox Width="240" Text="{Binding ValueFilter, Mode=TwoWay}" Watermark="Cell values: value1 &amp; value2…" ToolTip.Tip="Keep columns where a row shown has a cell containing any term. Separate terms with &amp;" MinHeight="36" Margin="0,0,10,8" />
              <TextBox Width="180" Text="{Binding FilterText, Mode=TwoWay}" Watermark="Row contains…" ToolTip.Tip="Keep rows where any cell contains this text" MinHeight="36" Margin="0,0,14,8" />
              <ComboBox ItemsSource="{Binding StepFilterOptions}" SelectedItem="{Binding StepFilter, Mode=TwoWay}" MinWidth="160" MinHeight="36" Margin="0,0,14,8" ToolTip.Tip="Show only this step's request and response columns" />
              <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,0,14,8">
                <Button Tag="show-options" Content="{Binding ShowOptionsTitle}" MinHeight="36" ToolTip.Tip="Choose what the table shows. Tick several options; the title lists what is on.">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Spacing="8" MinWidth="220">
                      <CheckBox Content="Show every column" IsChecked="{Binding ShowAllColumns, Mode=TwoWay}" />
                      <CheckBox Content="Failed rows only" IsChecked="{Binding ShowFailedOnly, Mode=TwoWay}" IsEnabled="{Binding HasResults}" />
                      <CheckBox Content="Failed columns only" IsChecked="{Binding ShowFailedColumns, Mode=TwoWay}" IsEnabled="{Binding HasResults}" ToolTip.Tip="Show only the expected-value columns that have a failed cell in the rows shown. Combine with Failed rows only to see just what went wrong" />
                      <CheckBox Content="Bug columns only" IsChecked="{Binding ShowBugColumns, Mode=TwoWay}" ToolTip.Tip="Show only the expected-value columns that carry a known-bug tag (&lt;bug: …&gt;) in the rows shown. Combine with Failed columns only to see both" />
                      <CheckBox Content="Failed cells only" IsChecked="{Binding ShowFailedCells, Mode=TwoWay}" IsEnabled="{Binding HasResults}" ToolTip.Tip="List only the expected-value cells that failed in the latest run, each with its header, what was expected and what the run got, and a button to assign the actual value" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <ComboBox Tag="environment-filter" ItemsSource="{Binding EnvironmentOptions}" SelectedItem="{Binding EnvironmentChoice, Mode=TwoWay}" IsVisible="{Binding HasEnvironmentChoice}" IsEnabled="{Binding HasResults}" MinWidth="150" ToolTip.Tip="Which environment the failed rows, columns and cells and the red marks refer to. The run covers several environments; All environments mixes them" />
              </StackPanel>
              <Button Content="Find &amp; replace" Command="{Binding OpenFindCommand}" Margin="0,0,8,8" MinHeight="36" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,8">
                <ComboBox Tag="csv-action" ItemsSource="{Binding CsvActions}" SelectedIndex="{Binding CsvActionIndex, Mode=TwoWay}" MinWidth="130" MinHeight="36" ToolTip.Tip="Choose Import CSV or Export CSV, then press the button beside it" />
                <Button Tag="csv-run" Content="▶" Command="{Binding RunCsvActionCommand}" MinHeight="36" MinWidth="36" ToolTip.Tip="Run the selected CSV action" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Banners: file changed on disk, and unsaved changes on close -->
    <StackPanel Grid.Row="1">
      <Border IsVisible="{Binding ExcelOpen}" Background="#3A2E14" BorderBrush="#8A6A1F" BorderThickness="0,0,0,1" Padding="20,8" Tag="excel-open">
        <TextBlock Text="This workbook is open in Excel. You can edit here, but saving will fail until you close it there." TextWrapping="Wrap" Foreground="#F3D9A4" FontSize="12.5" />
      </Border>
      <Border IsVisible="{Binding ConflictVisible}" Background="#3A2E14" BorderBrush="#8A6A1F" BorderThickness="0,0,0,1" Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="The workbook changed on disk" FontWeight="Bold" Foreground="#F6C76B" />
            <TextBlock Text="It was saved by someone else, or by Excel, after you opened it. Reload to take that version and lose your edits, or overwrite it with yours."
                       TextWrapping="Wrap" Foreground="#F3D9A4" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="Reload, lose my edits" Command="{Binding ReloadCommand}" />
            <Button Content="Overwrite with my edits" Classes="danger" Command="{Binding OverwriteAndSaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border IsVisible="{Binding RenameFixVisible}" Background="#12315A" BorderBrush="#2F6FD0" BorderThickness="0,0,0,1" Padding="20,12" Tag="rename-fix">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Fix references to the renamed column?" FontWeight="Bold" Foreground="#9CCBFF" />
            <TextBlock Text="{Binding RenameFixSummary}" TextWrapping="Wrap" Foreground="#C6DEFA" FontSize="12.5" />
            <TextBlock Text="{Binding RenameFixList}" FontFamily="Consolas,Menlo,monospace" FontSize="11.5" Foreground="#C6DEFA" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="Cancel" Command="{Binding CancelRenameFixCommand}" />
            <Button Content="Only rename" Command="{Binding SaveRenameOnlyCommand}" />
            <Button Content="Rename and fix" Classes="primary" Command="{Binding SaveFixingReferencesCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border IsVisible="{Binding ClosePromptVisible}" Background="#12315A" BorderBrush="#2F6FD0" BorderThickness="0,0,0,1" Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="You have unsaved changes" FontWeight="Bold" Foreground="#9CCBFF" />
            <TextBlock Text="Save them to the workbook before closing, or discard them." Foreground="#C6DEFA" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="Keep editing" Command="{Binding KeepEditingCommand}" />
            <Button Content="Discard and close" Classes="danger" Command="{Binding DiscardAndCloseCommand}" />
            <Button Content="Save and close" Classes="primary" Command="{Binding SaveAndCloseCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Testcases | data grid | problems -->
    <Grid Grid.Row="2" Margin="16,16,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="460" MinWidth="300" />
      </Grid.ColumnDefinitions>
      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast" ToolTip.Tip="Drag to resize" />

      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,6,0" ClipToBounds="True">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
          <ComboBox Tag="view-mode" ItemsSource="{Binding ViewModes}" SelectedIndex="{Binding ViewModeIndex, Mode=TwoWay}" MinWidth="210" MinHeight="36" ToolTip.Tip="View mode. Table view: the rows of the request and response sheets, one row per data row. Config edit mode: the steps of the testcase as forms. Record view: one data row as a list, each value built from parts." />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowData}" VerticalAlignment="Center"><TextBlock Text="{Binding RowCountText}" Foreground="#8EA4BC" VerticalAlignment="Center" /><TextBlock Text="{Binding SelectionText}" Foreground="#8CC1FF" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,10">
        <Border IsVisible="{Binding ColumnFiltersVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="COLUMN FILTERS · ROWS MUST MATCH ALL" />
            <WrapPanel Classes="form">
              <ComboBox ItemsSource="{Binding FilterColumnOptions}" SelectedItem="{Binding NewFilterColumn, Mode=TwoWay}" MinWidth="240" />
              <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.FilterOperators}" SelectedItem="{Binding NewFilterOperator, Mode=TwoWay}" MinWidth="150" />
              <TextBox Text="{Binding NewFilterValue, Mode=TwoWay}" IsVisible="{Binding NewFilterNeedsValue}" Watermark="Value" MinWidth="200" />
              <Button Content="Add filter" Classes="primary" Command="{Binding AddColumnFilterCommand}" />
              <Button Content="Clear all" Command="{Binding ClearColumnFiltersCommand}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding ColumnFilters}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ColumnFilter">
                  <Border Background="#16335A" BorderBrush="#2F6FD0" BorderThickness="1" CornerRadius="14" Padding="10,3,4,3" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="12.5" />
                      <Button Content="✕" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" MinHeight="22" MinWidth="22" Padding="0" FontSize="11" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding FindVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="FIND &amp; REPLACE (in the rows shown)" />
            <WrapPanel Classes="form">
              <TextBox x:Name="FindBox" Text="{Binding FindText, Mode=TwoWay}" Watermark="Find" MinWidth="200" />
              <TextBox Text="{Binding ReplaceText, Mode=TwoWay}" Watermark="Replace with" MinWidth="200" />
              <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.FindScopes}" SelectedItem="{Binding FindScope, Mode=TwoWay}" MinWidth="150" />
              <CheckBox Content="Match case" IsChecked="{Binding FindMatchCase, Mode=TwoWay}" />
              <CheckBox Content="Whole cell" IsChecked="{Binding FindWholeCell, Mode=TwoWay}" />
              <Button Content="Replace all" Classes="primary" Command="{Binding ReplaceAllCommand}" />
              <Button Content="Close" Command="{Binding CloseFindCommand}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding MatchSummary}" Foreground="#8EA4BC" />
              <TextBlock Foreground="#8EA4BC" IsVisible="{Binding FindScopeIsCurrent}">
                <Run Text="Current column:" /><Run Text="{Binding CurrentColumnTitle, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding CellEditorVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="{Binding CellEditorTitle, StringFormat='CELL · {0}'}" />
            <TextBox Text="{Binding CellEditorText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180" MaxHeight="360" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" />
            <WrapPanel Classes="form">
              <Button Content="Apply" Classes="primary" Command="{Binding ApplyCellEditorCommand}" />
              <Button Content="Cancel" Command="{Binding CloseCellEditorCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding TestcasePanelVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="{Binding TestcasePanelTitle}" />
            <WrapPanel Classes="form">
              <TextBox x:Name="TestcaseNameBox" Text="{Binding TestcasePanelName, Mode=TwoWay}" IsVisible="{Binding TestcasePanelAsksName}" MinWidth="320" />
              <CheckBox Content="Copy template and query files" IsChecked="{Binding TestcasePanelCopyTemplate, Mode=TwoWay}" IsVisible="{Binding TestcasePanelAsksTemplate}" />
              <Button Content="{Binding TestcasePanelConfirmText}" Classes="primary" Command="{Binding ConfirmTestcaseActionCommand}" IsVisible="{Binding !TestcasePanelIsDelete}" />
              <Button Content="{Binding TestcasePanelConfirmText}" Classes="danger" Command="{Binding ConfirmTestcaseActionCommand}" IsVisible="{Binding TestcasePanelIsDelete}" />
              <Button Content="Cancel" Command="{Binding CloseTestcasePanelCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding TestcasePanelNote}" Foreground="#8EA4BC" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding SheetPanelVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="{Binding SheetPanelTitle}" />
            <WrapPanel Classes="form">
              <TextBox Text="{Binding SheetPanelName, Mode=TwoWay}" IsVisible="{Binding SheetPanelAsksName}" Watermark="Name" MinWidth="260" />
              <NumericUpDown Value="{Binding SheetPanelCount, Mode=TwoWay}" IsVisible="{Binding SheetPanelAsksCount}" Minimum="1" Maximum="500" Increment="1" FormatString="0" Width="130" ToolTip.Tip="How many" />
              <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.SheetColumnPlacements}" SelectedItem="{Binding SheetPanelPlacement, Mode=TwoWay}" IsVisible="{Binding SheetPanelAsksPlacement}" MinWidth="200" />
              <Button Content="{Binding SheetPanelConfirmText}" Classes="primary" Command="{Binding ConfirmSheetActionCommand}" IsVisible="{Binding !SheetPanelIsDelete}" />
              <Button Content="{Binding SheetPanelConfirmText}" Classes="danger" Command="{Binding ConfirmSheetActionCommand}" IsVisible="{Binding SheetPanelIsDelete}" />
              <Button Content="Cancel" Command="{Binding CloseSheetPanelCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding SheetPanelNote}" Foreground="#8EA4BC" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding EditColumnVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="{Binding EditColumnTitle, StringFormat='COLUMN · {0}'}" />
            <WrapPanel Classes="form">
              <TextBox Text="{Binding EditColumnName, Mode=TwoWay}" MinWidth="320" />
              <Button Content="Rename" Classes="primary" Command="{Binding ConfirmRenameColumnCommand}" />
              <Button Content="Remove column" Classes="danger" Command="{Binding ConfirmRemoveColumnCommand}" />
              <Button Content="Cancel" Command="{Binding CloseEditColumnCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding EditColumnNote}" Foreground="#8EA4BC" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding AddColumnVisible}" Classes="panel" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Classes="caption" Text="NEW DATA COLUMN" />
            <WrapPanel Classes="form">
              <ComboBox ItemsSource="{Binding NewColumnSteps}" SelectedItem="{Binding NewColumnStep, Mode=TwoWay}" PlaceholderText="Step" MinWidth="160" />
              <ComboBox ItemsSource="{x:Static vm:DataEditorViewModel.ColumnKinds}" SelectedItem="{Binding NewColumnKind, Mode=TwoWay}" MinWidth="150" />
              <ComboBox IsVisible="{Binding NewColumnIsExpected}" ItemsSource="{x:Static vm:DataEditorViewModel.AssertionVerbs}" SelectedItem="{Binding NewColumnVerb, Mode=TwoWay}" MinWidth="130" />
              <TextBox Text="{Binding NewColumnName, Mode=TwoWay}" Watermark="{Binding NewColumnHint}" MinWidth="260" />
              <NumericUpDown Value="{Binding NewColumnCount, Mode=TwoWay}" Minimum="1" Maximum="200" Increment="1" FormatString="0" Width="120" ToolTip.Tip="How many columns to add (1, 2, 3… is added to the name when more than one)" />
              <ComboBox ItemsSource="{Binding PlacementOptions}" SelectedItem="{Binding NewColumnPlacement, Mode=TwoWay}" MinWidth="200" ToolTip.Tip="Before the selected column = before the column whose cell you last clicked (same sheet only)" />
              <Button Content="Add column" Classes="primary" Command="{Binding ConfirmAddColumnCommand}" />
              <Button Content="Cancel" Command="{Binding CancelAddColumnCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
        <Border Grid.Row="2" IsVisible="{Binding ShowData}" Classes="panel" ClipToBounds="True">
          <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Tag="sheet-tab-bar">
          <ListBox x:Name="SheetTabs" ItemsSource="{Binding OpenSheets}" SelectedItem="{Binding ActiveSheet, Mode=TwoWay}" IsVisible="{Binding OpenSheets.Count, Converter={x:Static vm:SheetTabsConverters.MoreThanOne}}" Background="Transparent">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
              <Button x:Name="SheetFilterButton" Classes="treemove" Padding="8,4" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.Tip="Choose which sheets of the workbook are shown, each as its own tab. Remembered for this instance.">
                <TextBlock Text="▾" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <ItemsControl ItemsSource="{Binding SheetChoices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SheetChoice">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsShown, Mode=TwoWay}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Content="＋" Tag="add-sheet" Command="{Binding OpenAddSheetCommand}" Classes="treemove" Padding="8,4" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.Tip="Add a new empty sheet to the workbook (written on Save)" />
          </StackPanel>
          <WrapPanel DockPanel.Dock="Top" IsVisible="{Binding IsOtherSheet}" Classes="form" Margin="8,8,8,0">
            <TextBlock Text="{Binding ActiveSheet, StringFormat='SHEET · {0}'}" Classes="caption" />
            <Button Content="＋ Rows…" Command="{Binding OpenAddSheetRowsCommand}" ToolTip.Tip="Add empty rows at the end" />
            <Button Content="Remove row" Command="{Binding RemoveSheetRowCommand}" IsEnabled="{Binding SelectedSheetRow, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Remove the selected row" />
            <Border Width="1" Background="#22364D" Margin="2,4" />
            <Button Content="＋ Columns…" Command="{Binding OpenAddSheetColumnsCommand}" ToolTip.Tip="Add one or more columns" />
            <Button Content="Rename column" Command="{Binding OpenRenameSheetColumnCommand}" ToolTip.Tip="Acts on the column whose cell you last clicked" />
            <Button Content="Remove column" Command="{Binding OpenRemoveSheetColumnCommand}" ToolTip.Tip="Acts on the column whose cell you last clicked" />
            <Border Width="1" Background="#22364D" Margin="2,4" />
            <Button Content="Rename sheet" Command="{Binding OpenRenameSheetCommand}" />
            <Button Content="Remove sheet" Classes="danger" Command="{Binding OpenRemoveSheetCommand}" />
          </WrapPanel>
          <DataGrid x:Name="SheetGrid"
                    IsVisible="{Binding ShowSheetGrid}"
                    ItemsSource="{Binding SheetRows}"
                    SelectedItem="{Binding SelectedSheetRow, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    SelectionMode="Extended"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalGridLinesBrush="#1B2D44"
                    VerticalGridLinesBrush="#1B2D44" />
          <Border x:Name="FailedCellsHost" IsVisible="{Binding ShowFailedCellsList}" />
          <DataGrid x:Name="Grid"
                    IsVisible="{Binding ShowTableGrid}"
                    ItemsSource="{Binding VisibleRows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    SelectionMode="Extended"
                    GridLinesVisibility="All"
                    HeadersVisibility="Column"
                    FrozenColumnCount="2"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalGridLinesBrush="#1B2D44"
                    VerticalGridLinesBrush="#1B2D44" />
          </DockPanel>
        </Border>
        <Border x:Name="RecordHost" Grid.Row="2" IsVisible="{Binding ShowRecord}" Classes="panel" ClipToBounds="True" />
        <Border Grid.Row="2" IsVisible="{Binding ShowSteps}" Classes="panel" ClipToBounds="True">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="#22364D" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Steps run top to bottom, in sheet order. Renaming a step also renames its data columns and updates references to it." Foreground="#8EA4BC" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                  <TextBlock Text="{Binding StepCountText}" Foreground="#8EA4BC" VerticalAlignment="Center" />
                  <Button Content="All steps" Command="{Binding ShowAllStepsCommand}" IsVisible="{Binding HasFocusedStep}" />
                  <Button Content="Expand all" Command="{Binding ExpandAllStepsCommand}" IsVisible="{Binding NoFocusedStep}" />
                  <Button Content="Collapse all" Command="{Binding CollapseAllStepsCommand}" IsVisible="{Binding NoFocusedStep}" />
                </StackPanel>
              </Grid>
            </Border>
            <DataGrid x:Name="StepsGrid"
                      IsVisible="{Binding ShowStepTable}"
                      ItemsSource="{Binding StepRows}"
                      SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Extended"
                      GridLinesVisibility="All"
                      HeadersVisibility="Column"
                      FrozenColumnCount="1"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalGridLinesBrush="#1B2D44"
                      VerticalGridLinesBrush="#1B2D44" />
            <ScrollViewer x:Name="StepCardsScroll" IsVisible="{Binding ShowStepCards}" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14" Spacing="10">
                <!-- one step alone, from the tree -->
                <ContentControl Content="{Binding FocusedStep}" IsVisible="{Binding HasFocusedStep}" ContentTemplate="{x:Static vm:StepFormTemplates.Form}" />
                <!-- all steps of the testcase, collapsed until opened -->
                <ItemsControl ItemsSource="{Binding StepRows}" IsVisible="{Binding NoFocusedStep}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepRowViewModel">
                      <Border Classes="stepcard" Margin="{Binding CardMargin}">
                        <StackPanel>
                          <Grid ColumnDefinitions="*,Auto">
                          <Button Tag="toggle" Classes="stepheader" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,22,48,Auto,Auto,*,Auto">
                              <Viewbox Width="16" Height="16" Margin="0,0,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{Binding IconData}" Stroke="#8EA4BC" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                              <TextBlock Grid.Column="1" Text="{Binding IsExpanded, Converter={x:Static vm:StepConverters.Chevron}}" Foreground="#8EA4BC" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="Open or close this step" />
                              <TextBlock Grid.Column="2" Text="{Binding NumberText}" Foreground="#8EA4BC" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding CurrentName}" FontWeight="SemiBold" Foreground="#E3EDF9" VerticalAlignment="Center" Margin="0,0,12,0" />
                              <TextBlock Grid.Column="4" Text="{Binding TypeText}" Foreground="#6FB7FF" VerticalAlignment="Center" Margin="0,0,12,0" />
                              <TextBlock Grid.Column="5" Text="{Binding SummaryText}" Foreground="#8EA4BC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="6" Text="{Binding EnabledText}" Foreground="{Binding EnabledColor, Converter={x:Static vm:StepConverters.Brush}}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                          </Button>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Button Tag="step-up" Classes="treemove" Content="▲" FontSize="11" Padding="6,4" Command="{Binding MoveUpCommand}" ToolTip.Tip="Run this step earlier" />
                            <Button Tag="step-down" Classes="treemove" Content="▼" FontSize="11" Padding="6,4" Command="{Binding MoveDownCommand}" ToolTip.Tip="Run this step later" />
                            <Button Tag="step-duplicate" Classes="treemove" Padding="6,4" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate this step (asks for the new name)">
                              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M9 9h11v11H9z M5 15V4h11" Stroke="#8EA4BC" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                            </Button>
                            <Button Tag="step-remove" Classes="treemove" Padding="6,4" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this step and its data columns (Undo brings them back)">
                              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13 M10 11v6 M14 11v6" Stroke="#F0707D" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Canvas></Viewbox>
                            </Button>
                          </StackPanel>
                          </Grid>
                          <ContentControl Content="{Binding ExpandedContent}" ContentTemplate="{x:Static vm:StepFormTemplates.Form}" Margin="12,4,12,12" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <Border x:Name="RightHost" Grid.Column="2" ClipToBounds="True">
      <Grid x:Name="WorkbookSide" RowDefinitions="*,Auto">
      <Border Classes="panel" Padding="14" IsVisible="{Binding PreviewVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
            <TextBlock Classes="caption" Text="PREVIEW · SELECTED ROW" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding PreviewStepNames}" SelectedItem="{Binding PreviewStepName, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="Edit template…" Command="{Binding EditTemplateCommand}" Margin="8,0,0,0" ToolTip.Tip="Open this step's template file in the template editor" />
            </Grid>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.Warning}" IsVisible="{Binding Preview.HasWarning, FallbackValue=False}" Foreground="#F6C76B" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
          <ScrollViewer>
            <StackPanel Spacing="6" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Preview.Title}" FontWeight="SemiBold" />
              <TextBox Text="{Binding Preview.Url, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
              <TextBlock Classes="caption" Text="HEADERS" IsVisible="{Binding Preview.HeadersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
              <TextBox Text="{Binding Preview.HeadersText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="12" IsVisible="{Binding Preview.HeadersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
              <TextBlock Classes="caption" Text="BODY" />
              <TextBox Text="{Binding Preview.Body, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="140" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Classes="panel" Padding="14" IsVisible="{Binding !PreviewVisible}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
            <TextBlock Classes="caption" Text="PROBLEMS" />
            <TextBlock Text="{Binding ProblemSummary}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" IsVisible="{Binding HasNoProblems}" Foreground="#39D39B"
                     Text="The runner will accept this workbook." TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProblemViewModel">
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="10" Padding="8,1" Background="{Binding BadgeBackground}">
                      <TextBlock Text="{Binding SeverityText}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Location}" Foreground="#8EA4BC" FontSize="11.5" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Classes="panel" Padding="14" Margin="0,12,0,0" MaxHeight="360" IsVisible="{Binding HasRowResult}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="caption" Text="LAST RUN · SELECTED ROW" />
            <TextBlock Text="{Binding RowResultHeadline}" Foreground="{Binding RowResultColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox ItemsSource="{Binding RowFailures}" SelectedItem="{Binding SelectedFailure, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FailureViewModel">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="10" Padding="8,1" Background="#432333">
                      <TextBlock Text="{Binding Kind}" Foreground="#FF7588" FontSize="10.5" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="#C9D8EA" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      </Grid>
      </Border>
    </Grid>

    <!-- Status line -->
    <Border Grid.Row="3" Background="#0F1C2E" BorderBrush="#22364D" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#8EA4BC" TextTrimming="CharacterEllipsis">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Foreground" Value="#8EA4BC" />
            </Style>
          </TextBlock.Styles>
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="#8EA4BC" FontSize="12" Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
  </Grid>
</Window>
