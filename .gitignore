# .NET build output
bin/
obj/

# Runtime output
Results/
History/
Logs/
.running/

# Local workbooks and generated archives
*.xlsx
*.xlsm
*.zip

# ...but keep the workbooks that define the test instances and samples
!/DataEngine-all-parameters.xlsx
!/Instances/*/*.xlsx
!/samples/**/*.xlsx

# Excel lock/temp files and the editor's automatic backups stay ignored everywhere
~$*
*.backup.*.xlsx
*.xlsx.tmp-*

# Local IDE/user files
.vs/
.vscode/
*.user
*.suo

# Local runtime configuration overrides
appsettings.local.json

# Generated distributions and local visual checks
/dist/
/verification/
/ui-design-*.png

# Per-instance local run-selection preferences
**/.run-selection.json
**/.run-selection.json.tmp
